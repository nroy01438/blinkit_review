# Copy to .env and fill in. Every value here is read via config/settings.py,
# which fails loudly (not silently) if a required key is missing at the point
# it's actually needed — MOCK_MODE lets you run the whole pipeline with none
# of the external keys set.

# --- Mode switches ---
# MOCK_MODE=true runs every connector against bundled synthetic fixtures
# instead of live scraping/APIs, and MOCK_LLM=true (implied by MOCK_MODE)
# returns deterministic canned-but-schema-valid LLM responses instead of
# calling Groq. This mirrors the sibling Frontier app's MOCK_MODE.
MOCK_MODE=true
MOCK_LLM=true

# --- Database ---
DATABASE_URL=postgresql://aisle:aisle@localhost:5433/aisle_dev

# --- LLM ---
# Get a key at https://console.groq.com — the brief's original stack
# specified Anthropic/Claude, but this deployment runs on Groq instead
# (see aisle/llm/client.py's docstring for the swap).
GROQ_API_KEY=
# Bulk classification model — fast/cheap, used for the high-volume PM-Gate stages.
AISLE_BULK_MODEL=llama-3.1-8b-instant
# Stronger model for synthesis + adversarial verification.
AISLE_SYNTH_MODEL=llama-3.3-70b-versatile
AISLE_MAX_COST_USD=25.00

# --- Embeddings ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L12-v2
# "sentence-transformer" (real, needs network egress to Hugging Face) or
# "hashing" (deterministic local fallback, no network — see
# aisle/cluster/embed.py). Leave unset to auto-select: hashing under
# MOCK_MODE=true, sentence-transformer otherwise.
AISLE_EMBEDDING_PROVIDER=

# --- Reddit (optional; connector disabled in config/sources.yaml until set) ---
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=aisle-discovery-engine/0.1 by <your-reddit-username>

# --- Security ---
# Salt for author_hash (SHA256(author_id + salt)) — never store raw usernames.
AUTHOR_HASH_SALT=change-me-in-prod

# --- Cron / API ---
CRON_SECRET=change-me-in-prod
AISLE_API_PORT=8000
# Optional Slack/email-compatible webhook for the weekly digest (§12).
# Left unset, aisle.jobs.weekly logs digest_webhook_sent=false rather than
# silently pretending to have sent something.
AISLE_DIGEST_WEBHOOK_URL=

# --- Frontend ---
NEXT_PUBLIC_AISLE_API_URL=http://localhost:8000
