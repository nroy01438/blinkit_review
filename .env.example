# Copy this into Vercel's Environment Variables (Settings -> Environment
# Variables), not a local .env file — this app has no separate backend to
# run locally against; it IS the Next.js app in frontend/.

# --- Database ---
# Same Supabase connection string the previous version used. The `sources`
# and `documents` tables already exist there with real, already-synced
# reviews — nothing to migrate. This app creates one small extra table
# (`question_answers`) itself on first use.
DATABASE_URL=

# --- LLM ---
# Get a free key at https://console.groq.com
GROQ_API_KEY=

# --- Reddit (optional) ---
# Free, ~2 minutes at reddit.com/prefs/apps ("script" app type). Without
# these, Reddit sync falls back to the public unauthenticated endpoint,
# which works but is more likely to get rate-limited.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# --- Security ---
# Salt for hashing review authors before storing them — never store raw
# usernames. Any random string; keep it stable once set.
AUTHOR_HASH_SALT=change-me-in-prod
